# Gmail OAuth2 credentials (from Google Cloud Console)
# Run setup_auth.py locally to generate these values
GMAIL_CLIENT_ID=your_client_id_here
GMAIL_CLIENT_SECRET=your_client_secret_here
GMAIL_REFRESH_TOKEN=your_refresh_token_here

# Your Gmail address (sender and recipient of daily summary)
GMAIL_USER_EMAIL=your.email@gmail.com

# Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: override Claude model (default: claude-opus-4-5)
# CLAUDE_MODEL=claude-opus-4-5
